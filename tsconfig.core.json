{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "app/src/core/**/*.ts",
    "app/src/actions/logic.ts",
    "app/src/integrations.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}