{
  "name": "reccer",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "add": "deepspace add",
    "build": "vite build",
    "demo": "tsx scripts/demo.ts",
    "deploy": "deepspace deploy",
    "dev": "deepspace dev start",
    "lint": "eslint .",
    "login": "deepspace auth login",
    "screenshot": "deepspace test screenshot",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "deepspace test run api",
    "test:deepspace": "deepspace test run",
    "test:e2e": "deepspace test run e2e",
    "test:smoke": "deepspace test run smoke",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc -p tsconfig.core.json && tsc --noEmit",
    "undeploy": "deepspace app undeploy",
    "validate": "npm run typecheck && npm test && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "~1.6.0",
    "ai": "7.0.107",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "deepspace": "0.44.2",
    "docx": "^9.5.0",
    "hono": "^4.13.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "yjs": "^13.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@generouted/react-router": "^1.20.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.79.0"
  },
  "private": true
